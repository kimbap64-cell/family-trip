# 복사해서 .env 로 만들고 값을 채웁니다. .env 는 gitignore 되어 절대 GitHub에 올라가지 않습니다.
# 클라우드(GitHub Actions)에서 쓸 때는 같은 이름으로 저장소 Settings > Secrets 에 등록합니다.

# 유튜브 Data API v3 (Google Cloud Console) - 영상 검색/조회수/댓글수/구독자/댓글
YOUTUBE_API_KEY=

# (사용 안 함) 네이버 검색 오픈API는 2026-07-31 개발자센터 신규신청 종료로 NCP API HUB 이전.
# 네이버 후기·가격은 플레이스 상세 페이지에서 읽으므로 불필요.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# (선택) 구글 Places API (New) - 구글 별점, 휠체어 접근성, 폐업 여부
GOOGLE_PLACES_API_KEY=

# (선택) 공공데이터포털 기상청 단기예보 - 주말 추천용
DATA_GO_KR_KEY=

# 카카오는 kakao_token.json(gitignore)에 이미 있음. Actions에서 쓰려면 아래로 등록
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=
